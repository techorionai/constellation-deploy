# Test-only values for scripts/smoke-test.sh. They protect no real system.
CONSTELLATION_ENV_FILE=tests/smoke.env
CONSTELLATION_SERVICES=smoke_a,smoke_b

POSTGRES_USER=postgres
POSTGRES_PASSWORD=smoke-pg-admin-pw
VALKEY_ADMIN_PASSWORD=smoke-valkey-admin-pw
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=smoke-grafana-admin-pw
GRAFANA_PORT=0

SMOKE_A_DB_PASSWORD=smoke-a-db-pw
SMOKE_A_VALKEY_PASSWORD=smoke-a-valkey-pw
SMOKE_B_DB_PASSWORD=smoke-b'db-pw
SMOKE_B_VALKEY_PASSWORD=smoke-b-valkey-pw
