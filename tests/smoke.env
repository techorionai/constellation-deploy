# Test-only values for scripts/smoke-test.sh. They protect no real system.
CONSTELLATION_ENV_FILE=tests/smoke.env
CONSTELLATION_SERVICES=smoke_a,smoke_b,identity,events,audit,helpdesk

POSTGRES_USER=postgres
POSTGRES_PASSWORD=smoke-pg-admin-pw
# 6 services with the limit 50 make 300 connections. The limit must be lower than this value.
POSTGRES_MAX_CONNECTIONS=350
VALKEY_ADMIN_PASSWORD=smoke-valkey-admin-pw
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=smoke-grafana-admin-pw
GRAFANA_SECRET_KEY=smoke-grafana-secret-key
GRAFANA_PORT=0

SMOKE_A_DB_PASSWORD=smoke-a-db-pw
SMOKE_A_VALKEY_PASSWORD=smoke-a-valkey-pw
SMOKE_B_DB_PASSWORD=smoke-b'db-pw
SMOKE_B_VALKEY_PASSWORD=smoke-b-valkey-pw

# The password has the characters + / =, so the URL-encoded form differs from it.
IDENTITY_DB_PASSWORD=smoke+identity/db=pw
IDENTITY_DB_PASSWORD_URLENCODED=smoke%2Bidentity%2Fdb%3Dpw
IDENTITY_VALKEY_PASSWORD=smoke-identity-valkey-pw
IDENTITY_ISSUER=http://localhost:8080
IDENTITY_MASTER_KEY_ID=smoke-1
IDENTITY_PORT=0

# The password has the characters + / =, so the URL-encoded form differs from it.
EVENTS_DB_PASSWORD=smoke+events/db=pw
EVENTS_DB_PASSWORD_URLENCODED=smoke%2Bevents%2Fdb%3Dpw
EVENTS_VALKEY_PASSWORD=smoke-events-valkey-pw
EVENTS_CLIENT_KEY_ID=events-1

# The password has the characters + / =, so the URL-encoded form differs from it.
AUDIT_DB_PASSWORD=smoke+audit/db=pw
AUDIT_DB_PASSWORD_URLENCODED=smoke%2Baudit%2Fdb%3Dpw
AUDIT_VALKEY_PASSWORD=smoke-audit-valkey-pw
AUDIT_CLIENT_KEY_ID=audit-1
AUDIT_STREAM_READER=audit

# The password has the characters + / =, so the URL-encoded form differs from it.
HELPDESK_DB_PASSWORD=smoke+helpdesk/db=pw
HELPDESK_DB_PASSWORD_URLENCODED=smoke%2Bhelpdesk%2Fdb%3Dpw
HELPDESK_VALKEY_PASSWORD=smoke-helpdesk-valkey-pw
HELPDESK_CLIENT_KEY_ID=helpdesk-1
HELPDESK_PORT=0
