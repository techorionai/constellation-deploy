# Copy this file to .env and replace each "change-me" value.
# Make a password with: openssl rand -base64 32
# Do not commit .env.

# Path of this file for Compose. Do not change it for a normal install.
CONSTELLATION_ENV_FILE=.env

# Platform services. Comma-separated names. Each name matches ^[a-z][a-z0-9_]{0,31}$.
# For each name <svc>, add <SVC>_DB_PASSWORD and <SVC>_VALKEY_PASSWORD below.
# Example: CONSTELLATION_SERVICES=identity,events,audit,helpdesk
CONSTELLATION_SERVICES=identity,events,audit,helpdesk

# PostgreSQL admin. Read at the first start of an empty volume only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# 4 services with the limit 50 make 200 connections. The limit must be lower than this value.
POSTGRES_MAX_CONNECTIONS=250

# Valkey admin (the "default" user). Read at the first start of an empty volume only.
VALKEY_ADMIN_PASSWORD=change-me
VALKEY_MAXMEMORY=256mb
# Age limit of the audit streams of identity and events. Keep it longer than the longest stop of the audit service.
AUDIT_STREAM_RETENTION=24h

# Grafana. The admin password is read at the first start of an empty volume only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Key that Grafana uses to encrypt the secrets in its database. Make it with: openssl rand -base64 32
# A change later makes the stored data source secrets unreadable.
GRAFANA_SECRET_KEY=change-me
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# Retention
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h
TEMPO_RETENTION=72h

# Maximum number of connections for each service role in PostgreSQL. The default is 50.
# Keep (number of services x this value) lower than POSTGRES_MAX_CONNECTIONS.
SERVICE_DB_CONNECTION_LIMIT=50

# Per-service passwords. One pair for each name in CONSTELLATION_SERVICES.
IDENTITY_DB_PASSWORD=change-me
# The URL-encoded form of IDENTITY_DB_PASSWORD. The service puts it in its database URL.
IDENTITY_DB_PASSWORD_URLENCODED=change-me
IDENTITY_VALKEY_PASSWORD=change-me

# Identity service.
# The public URL that browsers use. It must agree with IDENTITY_BIND and IDENTITY_PORT.
IDENTITY_ISSUER=http://localhost:8080
# Path of the master key file on the host. Make the file as docs/compose.md says.
IDENTITY_MASTER_KEY_FILE=./secrets/identity-master-key
# ID of the master key. It is not a secret.
IDENTITY_MASTER_KEY_ID=identity-1
# Keep IDENTITY_BIND on 127.0.0.1 unless a TLS reverse proxy runs on the same host.
# IDENTITY_BIND=127.0.0.1
# IDENTITY_PORT=8080
# CIDR list of the reverse proxies in front of identity. Set it when you use a proxy.
# IDENTITY_TRUSTED_PROXIES=

# Upstream login with Google and Microsoft. Store the client secret before you set the client ID.
# The command reads the secret from the prompt and puts it on no command line (see docs/compose.md):
#   read -rs S && printf '%s\n' "$S" | docker compose exec -T identity /identity set-idp-secret google; unset S
# IDENTITY_GOOGLE_CLIENT_ID=
# Comma list of Google hosted domains. Empty means all Google accounts.
# IDENTITY_GOOGLE_ALLOWED_DOMAINS=
# IDENTITY_MICROSOFT_CLIENT_ID=
# A tenant GUID (recommended) or organizations.
# IDENTITY_MICROSOFT_TENANT=organizations
# The name that the browser shows when a user registers a passkey.
# IDENTITY_WEBAUTHN_RP_NAME=Constellation

# Events service.
EVENTS_DB_PASSWORD=change-me
# The URL-encoded form of EVENTS_DB_PASSWORD. The service puts it in its database URL.
EVENTS_DB_PASSWORD_URLENCODED=change-me
EVENTS_VALKEY_PASSWORD=change-me
# Path of the client key of the events service. Make it with scripts/new-service-client.sh events.
EVENTS_CLIENT_KEY_FILE=./secrets/events-client-key.pem
# ID of the client key. It is not a secret.
EVENTS_CLIENT_KEY_ID=events-1

# Audit service.
# The one service user that reads the audit streams. An unset value gives audit.
# The name must be in CONSTELLATION_SERVICES.
AUDIT_STREAM_READER=audit
AUDIT_DB_PASSWORD=change-me
# The URL-encoded form of AUDIT_DB_PASSWORD. The service puts it in its database URL.
AUDIT_DB_PASSWORD_URLENCODED=change-me
AUDIT_VALKEY_PASSWORD=change-me
# Path of the client key of the audit service. Make it with scripts/new-service-client.sh audit.
AUDIT_CLIENT_KEY_FILE=./secrets/audit-client-key.pem
# ID of the client key. It is not a secret.
AUDIT_CLIENT_KEY_ID=audit-1

# Helpdesk service.
HELPDESK_DB_PASSWORD=change-me
# The URL-encoded form of HELPDESK_DB_PASSWORD. The service puts it in its database URL.
HELPDESK_DB_PASSWORD_URLENCODED=change-me
HELPDESK_VALKEY_PASSWORD=change-me
# Path of the client key of the helpdesk. Make it with scripts/new-service-client.sh helpdesk events:producer.
HELPDESK_CLIENT_KEY_FILE=./secrets/helpdesk-client-key.pem
# ID of the client key. It is not a secret.
HELPDESK_CLIENT_KEY_ID=helpdesk-1
# Keep HELPDESK_BIND on 127.0.0.1 unless a TLS reverse proxy runs on the same host.
# HELPDESK_BIND=127.0.0.1
# HELPDESK_PORT=8081
# CIDR list of the reverse proxies in front of the helpdesk. Set it when you use a proxy.
# HELPDESK_TRUSTED_PROXIES=

# Path of the identity clients file on the host. The script scripts/new-service-client.sh writes it.
# IDENTITY_CLIENTS_PATH=./secrets/identity-clients.yaml
