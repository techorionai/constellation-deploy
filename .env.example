# Copy this file to .env and replace each "change-me" value.
# Make a password with: openssl rand -base64 32
# Do not commit .env.

# Path of this file for Compose. Do not change it for a normal install.
CONSTELLATION_ENV_FILE=.env

# Platform services. Comma-separated names. Each name matches ^[a-z][a-z0-9_]{0,31}$.
# For each name <svc>, add <SVC>_DB_PASSWORD and <SVC>_VALKEY_PASSWORD below.
# Example: CONSTELLATION_SERVICES=identity,audit
CONSTELLATION_SERVICES=

# PostgreSQL admin. Read at the first start of an empty volume only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_MAX_CONNECTIONS=200

# Valkey admin (the "default" user). Read at the first start of an empty volume only.
VALKEY_ADMIN_PASSWORD=change-me
VALKEY_MAXMEMORY=256mb

# Grafana. The admin password is read at the first start of an empty volume only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# Retention
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h
TEMPO_RETENTION=72h

# Per-service passwords. One pair for each name in CONSTELLATION_SERVICES.
# IDENTITY_DB_PASSWORD=change-me
# IDENTITY_VALKEY_PASSWORD=change-me
